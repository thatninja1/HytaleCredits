Group #Root {
  LayoutMode: Center;
  Anchor: (Full: 1);
  Background: #0b1220(0.92);

  Group #RootPanel {
    Anchor: (Width: 1400, Height: 760);
    LayoutMode: Top;
    Background: #0f1a2b(0.97);

    Label #TitleLabel {
      Anchor: (Top: 20, Width: 1360, Height: 56);
      Text: "Credit Shop";
      Style: (FontSize: 46, Alignment: Center, TextColor: #E5E7EB);
    }

    Label #CreditsBalanceLabel {
      Anchor: (Top: 6, Width: 1360, Height: 34);
      Text: "Credits: 0";
      Style: (FontSize: 24, Alignment: Center, TextColor: #93C5FD);
    }

    Label #SelectedCategoryLabel {
      Anchor: (Top: 4, Width: 1360, Height: 28);
      Text: "";
      Style: (FontSize: 20, Alignment: Center, TextColor: #CBD5E1);
    }

    Group #Body {
      Anchor: (Top: 16, Width: 1360, Height: 560);
      LayoutMode: Left;

      Group #CategoryColumn {
        Anchor: (Width: 340, Height: 560);
        LayoutMode: Top;

        Button #CategoryButton1 { Anchor: (Top: 4, Left: 10, Width: 320, Height: 34); Label #CategoryButton1Label { Anchor: (Width: 300, Height: 28); Text: "VIP"; Style: (FontSize: 18, Alignment: Start, TextColor: #FDE047); } }
        Button #CategoryButton2 { Anchor: (Top: 4, Left: 10, Width: 320, Height: 34); Label #CategoryButton2Label { Anchor: (Width: 300, Height: 28); Text: ""; Style: (FontSize: 18, Alignment: Start, TextColor: #FDE047); } }
