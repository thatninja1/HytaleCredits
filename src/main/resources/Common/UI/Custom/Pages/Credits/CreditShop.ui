        Button #CategoryButton6 { Anchor: (Top: 4, Left: 10, Width: 320, Height: 34); Label #CategoryButton6Label { Anchor: (Width: 300, Height: 28); Text: ""; Style: (FontSize: 18, Alignment: Start, TextColor: #FDE047); } }
        Button #CategoryButton7 { Anchor: (Top: 4, Left: 10, Width: 320, Height: 34); Label #CategoryButton7Label { Anchor: (Width: 300, Height: 28); Text: ""; Style: (FontSize: 18, Alignment: Start, TextColor: #FDE047); } }
        Button #CategoryButton8 { Anchor: (Top: 4, Left: 10, Width: 320, Height: 34); Label #CategoryButton8Label { Anchor: (Width: 300, Height: 28); Text: ""; Style: (FontSize: 18, Alignment: Start, TextColor: #FDE047); } }
        Button #CategoryButton9 { Anchor: (Top: 4, Left: 10, Width: 320, Height: 34); Label #CategoryButton9Label { Anchor: (Width: 300, Height: 28); Text: ""; Style: (FontSize: 18, Alignment: Start, TextColor: #FDE047); } }
        Button #CategoryButton10 { Anchor: (Top: 4, Left: 10, Width: 320, Height: 34); Label #CategoryButton10Label { Anchor: (Width: 300, Height: 28); Text: ""; Style: (FontSize: 18, Alignment: Start, TextColor: #FDE047); } }
        Button #CategoryButton11 { Anchor: (Top: 4, Left: 10, Width: 320, Height: 34); Label #CategoryButton11Label { Anchor: (Width: 300, Height: 28); Text: ""; Style: (FontSize: 18, Alignment: Start, TextColor: #FDE047); } }
