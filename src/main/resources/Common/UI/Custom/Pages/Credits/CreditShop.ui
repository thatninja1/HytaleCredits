          Button #ItemButton10 { Anchor: (Top: 6, Width: 920, Height: 34); Label #ItemButton10Label { Anchor: (Width: 900, Height: 26); Text: ""; Style: (FontSize: 18, Alignment: Start, TextColor: #E2E8F0); } }
          Button #ItemButton11 { Anchor: (Top: 6, Width: 920, Height: 34); Label #ItemButton11Label { Anchor: (Width: 900, Height: 26); Text: ""; Style: (FontSize: 18, Alignment: Start, TextColor: #E2E8F0); } }
          Button #ItemButton12 { Anchor: (Top: 6, Width: 920, Height: 34); Label #ItemButton12Label { Anchor: (Width: 900, Height: 26); Text: ""; Style: (FontSize: 18, Alignment: Start, TextColor: #E2E8F0); } }
