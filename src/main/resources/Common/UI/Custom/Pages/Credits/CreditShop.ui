          Style: (FontSize: 24, Alignment: Center, TextColor: #CBD5E1);
        }

        Group #ItemsList {
          Anchor: (Top: 12, Left: 20, Width: 940, Height: 470);
          LayoutMode: Top;

          Button #ItemButton1 { Anchor: (Top: 6, Width: 920, Height: 34); Label #ItemButton1Label { Anchor: (Width: 900, Height: 26); Text: ""; Style: (FontSize: 18, Alignment: Start, TextColor: #E2E8F0); } }
